{
  "buildCommand": "cd openplanter-desktop/frontend && npm run build",
  "outputDirectory": "openplanter-desktop/frontend/dist",
  "installCommand": "npm ci && npm ci --prefix openplanter-desktop/frontend",
  "framework": null,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    }
  ]
}
