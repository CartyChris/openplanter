{
  "name": "openplanter-web-server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others \"npm run dev:api\" \"npm --prefix openplanter-desktop/frontend run dev -- --host 0.0.0.0 --port 3000\"",
    "check:server": "tsc --noEmit -p tsconfig.server.json",
    "test:server": "node --import tsx --test server/*.test.ts",
    "dev:api": "NODE_ENV=development tsx --env-file-if-exists=.env.development.local server/dev.ts"
  },
  "dependencies": {
    "better-auth": "^1.7.14",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@vercel/node": "^28.0.0",
    "concurrently": "^10.0.6",
    "express": "^5.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
